##############################################################
#EXAMPLES OF STATIONARY GAUSSIAN PROCESSES
##############################################################
library(MASS) #mvrnorm
library(dtt)
x = seq(0, pi, length = p)
pp = 1
coef = c(0.8)
R.mat <- outer(1:p, 1:p, function(i, j) coef^abs(i - j)) #alternativ command
Sigma = sd^2 * R.mat
acf = Sigma[1, ]
sdf = acf2sdf(acf)
acf2sdf(sdf2acf(sdf))
sdf - acf2sdf(sdf2acf(sdf))
acf - sdf2acf(acf2sdf(acf))
x = seq(0, pi, length = p)
sdf = (abs(cos(pi * x))^gamma + 0.45)
#normalizing factor such that integral of sdf = 1
C = mean(abs(cos(pi * seq(0, 1, length = 100000)))^gamma + 0.45)*pi
sdf = sd^2 * sdf / (2*C)
acf = sdf2acf(sdf)
Sigma = toeplitz(acf)
Y = matrix(mvrnorm(n, mu = numeric(p), Sigma = Sigma), n, p)
sdf - acf2sdf(sdf2acf(sdf))
